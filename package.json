{
  "name": "rn-build-doctor",
  "version": "1.0.0",
  "description": "Pre-flight build diagnostic tool for React Native. Catch Android and iOS build failures before they happen.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "rn-build-doctor": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run test && npm run build"
  },
  "keywords": [
    "react-native",
    "rn",
    "build",
    "doctor",
    "gradle",
    "xcode",
    "cocoapods",
    "diagnostic",
    "android",
    "ios",
    "cli"
  ],
  "author": "Mehul & Community",
  "license": "MIT",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/mehul"
    },
    {
      "type": "buy-me-a-coffee",
      "url": "https://www.buymeacoffee.com/rnbuilddoctor"
    }
  ],
  "dependencies": {
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "execa": "^10.2.1",
    "ora": "^10.0.0",
    "semver": "^7.8.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
